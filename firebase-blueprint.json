{
  "entities": {
    "School": {
      "title": "School",
      "description": "Details about a school in the SaaS system.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "address": { "type": "string" },
        "logo": { "type": "string" },
        "currency": { "type": "string", "description": "e.g., PKR, USD" },
        "lateFeeRules": {
          "type": "object",
          "properties": {
            "tier1Days": { "type": "number" },
            "tier1Percent": { "type": "number" },
            "tier2Days": { "type": "number" },
            "tier2Percent": { "type": "number" },
            "fixedPenalty": { "type": "number" }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "currency"]
    },
    "User": {
      "title": "User",
      "description": "System user associated with a school.",
      "type": "object",
      "properties": {
        "schoolId": { "type": "string" },
        "role": { "type": "string", "enum": ["super_admin", "admin", "accountant"] },
        "email": { "type": "string" },
        "name": { "type": "string" }
      },
      "required": ["schoolId", "role", "email"]
    },
    "Student": {
      "title": "Student",
      "description": "Student record for fee management.",
      "type": "object",
      "properties": {
        "schoolId": { "type": "string" },
        "fullName": { "type": "string" },
        "grade": { "type": "string" },
        "fatherName": { "type": "string" },
        "motherName": { "type": "string" },
        "whatsappStudent": { "type": "string" },
        "whatsappFather": { "type": "string" },
        "whatsappMother": { "type": "string" },
        "feePlan": { "type": "number", "description": "Monthly fee amount" },
        "admissionDate": { "type": "string", "format": "date" },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["schoolId", "fullName", "grade", "feePlan", "status"]
    },
    "Invoice": {
      "title": "Invoice",
      "description": "Monthly fee invoice.",
      "type": "object",
      "properties": {
        "schoolId": { "type": "string" },
        "studentId": { "type": "string" },
        "month": { "type": "number" },
        "year": { "type": "number" },
        "baseAmount": { "type": "number" },
        "lateFee": { "type": "number" },
        "totalAmount": { "type": "number" },
        "dueDate": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["pending", "sent", "paid", "overdue"] },
        "lateFeeAppliedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["schoolId", "studentId", "month", "year", "baseAmount", "status", "dueDate"]
    },
    "Receipt": {
      "title": "Receipt",
      "description": "Payment receipt after invoice is paid.",
      "type": "object",
      "properties": {
        "schoolId": { "type": "string" },
        "invoiceId": { "type": "string" },
        "receiptNumber": { "type": "string" },
        "amountPaid": { "type": "number" },
        "paymentDate": { "type": "string", "format": "date-time" },
        "paymentMethod": { "type": "string" },
        "filePath": { "type": "string" }
      },
      "required": ["schoolId", "invoiceId", "amountPaid", "paymentDate"]
    }
  },
  "firestore": {
    "/schools/{schoolId}": { "schema": "School", "description": "Primary school configuration." },
    "/users/{userId}": { "schema": "User", "description": "User mapping to schools and roles." },
    "/schools/{schoolId}/students/{studentId}": { "schema": "Student", "description": "Students within a school." },
    "/schools/{schoolId}/invoices/{invoiceId}": { "schema": "Invoice", "description": "Invoices for students." },
    "/schools/{schoolId}/receipts/{receiptId}": { "schema": "Receipt", "description": "Generated receipts." }
  }
}
